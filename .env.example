# Fogón — variables de entorno de ejemplo.
# Copiar a .env y reemplazar cada "x" por el valor real.
# NUNCA subir el .env real al repositorio.

# --- Base de datos ---
DATABASE_URL="postgresql://x:x@localhost:5432/fogon?schema=public"
SQLITE_PATH="x"
POSTGRES_USER="x"
POSTGRES_PASSWORD="x"
POSTGRES_DB="x"

# --- Aplicación ---
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
EXPO_PUBLIC_API_URL="http://localhost:3000"
EXPO_PUBLIC_WEB_URL="http://localhost:3000"
AUTH_SECRET="x"
CRON_SECRET="x"
TRUST_PROXY="false"
CORS_ORIGINS="http://localhost:3000"
ALLOWED_DEV_ORIGINS="http://localhost:3000"
ALLOW_DEMO_SEED="true"
ALLOW_CASH_ORDERS="false"
NEXT_PUBLIC_DEMO_MODE="true"

# --- Pagos ---
PAYMENTS_MODE="demo"
MERCADOPAGO_ACCESS_TOKEN="x"
MERCADOPAGO_WEBHOOK_SECRET="x"
TRANSBANK_API_KEY="x"
TRANSBANK_COMMERCE_CODE="x"
TRANSBANK_ENVIRONMENT="integration"
FLOW_API_KEY="x"
FLOW_SECRET_KEY="x"
FLOW_ENVIRONMENT="sandbox"
FLOW_PAYMENT_METHOD="webpay"
FLOW_PAYMENT_METHOD_WEBPAY="true"
FLOW_PAYMENT_METHOD_MACH="true"
FLOW_TIMEOUT_SECONDS="900"

# --- Identidad / KYC ---
KYC_PROVIDER="demo"
KYC_REQUIRED="false"
KYC_HOSTED_URL="x"
KYC_WEBHOOK_SECRET="x"
DIDIT_API_KEY="x"
DIDIT_WORKFLOW_ID="x"
DIDIT_WORKFLOW_API_KEY="x"
DIDIT_WORKFLOW_LABEL="x"
DIDIT_CALLBACK_URL="x"
DIDIT_WEBHOOK_SECRET="x"
DIDIT_TARGET_WORKFLOW_ID="x"
DIDIT_ENVIRONMENT="sandbox"
DIDIT_PUBLISH="false"
DIDIT_ENABLE_NFC="false"
DIDIT_FORCE_PATCH="false"

# --- Seguridad / MFA ---
MFA_ENCRYPTION_KEY="x"
MFA_ENFORCED="false"
PII_RETENTION_DAYS="30"
USER_RETENTION_DAYS="365"

# --- Reparto ---
COURIER_SECURITY_ENFORCED="true"
COURIER_PICKUP_RADIUS_KM="0.15"
COURIER_MAX_SPEED_KMH="120"
COURIER_LOCATION_MAX_AGE_MIN="5"

# --- Correo / SMS ---
EMAIL_FROM="no-reply@example.com"
EMAIL_VERIFICATION_REQUIRED="false"
RESEND_API_KEY="x"
TWILIO_ACCOUNT_SID="x"
TWILIO_AUTH_TOKEN="x"
TWILIO_FROM="+10000000000"
